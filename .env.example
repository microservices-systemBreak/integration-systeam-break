# --- Database Configuration ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME_CORE=sb_core_db
DB_NAME_VULN=sb_vuln_db
DB_NAME_ERROR=sb_error_db
DB_NAME_AUTH=sb_auth_db
DB_NAME_REPORTING=sb_reporting_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL_MODE=disable

# --- RabbitMQ Configuration ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- JWT Configuration ---
JWT_SECRET=YOUR_SECRET_KEY_HERE_MUST_BE_MIN_32_BYTES_BASE64
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Service Ports (Host Mapping) ---
PORT_AUTH=8083
PORT_GATEWAY=8080
PORT_CORE=5000
PORT_VULN=8081
PORT_ERROR=8082
PORT_REPORTING=8084

# --- Environment ---
ASPNETCORE_ENVIRONMENT=Production
